# ============================================================
# Fine Arts Club — Environment Variables
# Copy this file to `.env` to configure local / build-time values.
# `.env` is gitignored and must never be committed (TRD §18.5).
# Only the values below are read by the app. No secrets exist.
# ============================================================

# Form submission endpoint (serverless function URL).
# When set, src/lib/forms.js POSTs form payloads here as JSON.
# When unset (default), forms return a clear "not live yet" message
# and send nothing — the site stays fully static and safe to ship.
# Wire this only once the function is deployed (see TRD §18.3).
VITE_FORM_ENDPOINT=

# ------------------------------------------------------------
# Site origin (finalize at deployment time, TRD §15.2)
# ------------------------------------------------------------
# The production origin is currently hard-coded in:
#   - src/lib/seo.jsx        (SITE_URL constant)
#   - public/sitemap.xml     (per-page URLs)
#   - public/robots.txt      (sitemap reference)
# Update all three together to match the deployed host.
# Canonical/OG URLs resolve from window.location.origin at runtime,
# so they always match the domain actually serving the page.
